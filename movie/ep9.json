"lines": [
{
"start": 3.4499999999999997,
"key": "Q01",
"dur": 2.96,
"text": "الحيطة... الحيطة بتخبط تاني!"
},
{
"start": 8.26,
"key": "Q02",
"dur": 4.64,
"text": "لغز امبارح: الحاجة الناقصة في الأوضة... الصورة! شوفوا مكانها على الحيطة."
},
{
"start": 14.899999999999999,
"key": "Q03",
"dur": 4.48,
"text": "نفس الصورة اللي تيتا كانت بتعيط عليها. يعني حد خدها من هنا."
},
{
"start": 20.18,
"key": "Q04",
"dur": 4.32,
"text": "اسكتوا! ده مورس... بيقول: جاي... جاي!"
},
{
"start": 25.0,
"key": "Q05",
"dur": 3.92,
"text": "مين اللي جاي؟! أنا مش هستنى. هنزل بالبكرة! ثقوا فيا!"
},
{
"start": 31.270000000000003,
"key": "Q06",
"dur": 7.12,
"text": "إحنا في الدور السابع يا شطة. أنا حاسبها بالقلم... هتنزل أسرع من الأسانسير. وإحنا معندناش أسانسير!"
},
{
"start": 39.14,
"key": "Q07",
"dur": 2.72,
"text": "الكشاف... الكشاف بيطفي!"
},
{
"start": 45.059999999999995,
"key": "Q08",
"dur": 1.05,
"text": "عفريت!"
},
{
"start": 47.809999999999995,
"key": "Q09",
"dur": 3.04,
"text": "اهدوا يا ولاد... أنا صاحي أهو."
},
{
"start": 50.99999999999999,
"key": "Q10",
"dur": 3.12,
"text": "يعني إنت اللي قفلت علينا الباب؟"
},
{
"start": 54.21999999999999,
"key": "Q11",
"dur": 4.24,
"text": "لا يا ابني... أنا اللي فتحت. اسمعوني كويس."
},
{
"start": 59.01,
"key": "Q12",
"dur": 9.76,
"text": "المكان ده كان بتاع رشدي... أخو الحاجة نعناعة. قبل ما يسافر من تلاتين سنة، خبى هنا سر كبير."
},
{
"start": 69.27,
"key": "Q13",
"dur": 1.44,
"text": "سر إيه؟"
},
{
"start": 70.80999999999999,
"key": "Q14",
"dur": 8.32,
"text": "إن العمارة دي بتاعة السكان كلهم. ومن يومها وأنا بدور عليه كل ليلة، وبخبط بالمورس... زي ما اتفقنا."
},
{
"start": 79.33,
"key": "Q15",
"dur": 4.24,
"text": "يعني الخبط كله كان إنت! خضتنا يا راجل!"
},
{
"start": 83.66999999999999,
"key": "Q16",
"dur": 4.16,
"text": "لا يا ابني... الخبط بتاع الساعة اتناشر... ده مش أنا."
},
{
"start": 92.13,
"key": "Q17",
"dur": 5.44,
"text": "لغز النهارده: مين اللي قفل علينا الباب؟ الدليل في إيدي... اكتبوا في الكومنتات!"
},
{
"start": 99.96999999999998,
"key": "Q18",
"dur": 4.96,
"text": "أيوه... كله ماشي زي ما اتفقنا. العمارة هتتباع بكرة الصبح."
},
{
"start": 105.82999999999998,
"key": "Q19",
"dur": 1.44,
"text": "بكرة الصبح؟!"
}
]
}