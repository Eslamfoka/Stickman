"lines": [
{
"start": 6.3,
"key": "L00",
"dur": 2.16,
"text": "آآآه! النور قطع!"
},
{
"start": 12.76,
"key": "L01",
"dur": 4.08,
"text": "سامعين؟ الصوت جاي من فوق... من الدور السابع!"
},
{
"start": 17.14,
"key": "L02",
"dur": 6.0,
"text": "الدور السابع مقفول بقاله تلاتين سنة يا شطة. يعني احتمال إن فيه حد فوق... صفر."
},
{
"start": 25.64,
"key": "L03",
"dur": 2.64,
"text": "...أنا هعيد الحسبة."
},
{
"start": 28.580000000000002,
"key": "L04",
"dur": 5.76,
"text": "الخبط ده مش عشوائي. اسمعوا كويس... تلات خبطات، وبعدين سكوت."
},
{
"start": 34.84,
"key": "L05",
"dur": 3.68,
"text": "محدش هيطلع فوق. فاهمين؟ محدش!"
},
{
"start": 38.77,
"key": "L06",
"dur": 3.36,
"text": "يا تيتا! خضيتينا! هو مين اللي فوق؟"
},
{
"start": 42.43,
"key": "L07",
"dur": 3.52,
"text": "...مفيش حد. يلا، كل واحد على سريره."
},
{
"start": 47.45,
"key": "L08",
"dur": 4.64,
"text": "أنا طالع أشوف. بكرة الساعة اتناشر بالظبط. ثقوا فيا المرة دي!"
},
{
"start": 52.39,
"key": "L09",
"dur": 3.6,
"text": "آخر مرة قالها، العمارة كلها اتشبشبت."
},
{
"start": 56.29,
"key": "L10",
"dur": 4.24,
"text": "وأنا جاية معاكو. إنتو مش هتعرفوا تعدوا الخبط صح من غيري."
},
{
"start": 60.93,
"key": "L11",
"dur": 4.96,
"text": "وإنتو كمان! عدوا الخبط معانا، واكتبوا في الكومنتات... كام خبطة سمعتو؟"
},
{
"start": 69.49000000000001,
"key": "L12",
"dur": 3.52,
"text": "بدأت تاني يا رشدي؟... إنت بدأت تاني."
},
{
"start": 76.01,
"key": "L13",
"dur": 2.8,
"text": "«ما تطلعوش»... مين اللي كتب دي؟"
}
]
}