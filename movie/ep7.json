"lines": [
{
"start": 0.15,
"key": "N00",
"dur": 1.44,
"text": "رشدي؟..."
},
{
"start": 1.8399999999999999,
"key": "N01",
"dur": 3.6,
"text": "...مفيش. يلا، كل واحد على سريره، حالا!"
},
{
"start": 5.79,
"key": "N02",
"dur": 2.72,
"text": "تيتا عارفة رشدي... أنا متأكد."
},
{
"start": 10.56,
"key": "N03",
"dur": 5.36,
"text": "لغز امبارح: اللي كتبوا نانا... برافو عليكو! الرسالة كانت لتيتا نعناعة."
},
{
"start": 16.07,
"key": "N04",
"dur": 5.12,
"text": "كل الأدلة هنا في الكشكول: الخبط، والسماعات، والمفتاح."
},
{
"start": 21.290000000000003,
"key": "N05",
"dur": 3.12,
"text": "هحطه على الدكة ثانية واحدة، وأربط الجزمة."
},
{
"start": 24.810000000000006,
"key": "N06",
"dur": 4.0,
"text": "صباح الفل يا حلوين! ...أيوه يا باشا، أنا في المدخل."
},
{
"start": 28.910000000000007,
"key": "N07",
"dur": 3.2,
"text": "الأرض دي مش بتنضف أبدا..."
},
{
"start": 32.160000000000004,
"key": "N08",
"dur": 2.48,
"text": "يا ولاد! محدش يلعب في المدخل!"
},
{
"start": 40.74000000000001,
"key": "N09",
"dur": 2.56,
"text": "الكشكول... الكشكول اتسرق!"
},
{
"start": 43.35000000000001,
"key": "N10",
"dur": 2.64,
"text": "مين اللي خده؟! كلكم كنتوا هنا!"
},
{
"start": 47.540000000000006,
"key": "N11",
"dur": 3.12,
"text": "أنا؟ أنا كنت بكلم الباشا في التليفون."
},
{
"start": 50.78,
"key": "N12",
"dur": 1.92,
"text": "أنا كنت بكنس."
},
{
"start": 52.82,
"key": "N13",
"dur": 2.64,
"text": "وأنا هسرق كشكول؟! يا ولد!"
},
{
"start": 56.68,
"key": "N14",
"dur": 2.48,
"text": "استنوا... أنا شفت حاجة غريبة."
},
{
"start": 59.75999999999999,
"key": "N15",
"dur": 5.36,
"text": "لغز النهارده: مين الحرامي؟ ركزوا في التفاصيل... واكتبوا في الكومنتات!"
},
{
"start": 67.61999999999998,
"key": "N16",
"dur": 4.56,
"text": "سامحني يا رشدي... تلاتين سنة وأنا ساكتة."
}
]
}