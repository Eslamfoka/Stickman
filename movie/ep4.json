"lines": [
{
"start": 0.1,
"key": "J00",
"dur": 1.6,
"text": "أنا شايفكم."
},
{
"start": 2.0,
"key": "J01",
"dur": 3.2,
"text": "الساعة اتناشر يا ولاد... مكانكم في السرير."
},
{
"start": 5.3500000000000005,
"key": "J02",
"dur": 3.12,
"text": "واللي بيخبط... مش أنا لوحدي."
},
{
"start": 12.27,
"key": "J03",
"dur": 7.36,
"text": "لغز امبارح: الخبط ده شفرة مورس، يعني رسالة بالخبط! ومعناها إشارة استغاثة... SOS!"
},
{
"start": 19.779999999999998,
"key": "J04",
"dur": 2.64,
"text": "يعني البواب بيستنجد بحد فوق؟"
},
{
"start": 22.52,
"key": "J05",
"dur": 5.52,
"text": "أو حد فوق هو اللي بيستنجد بيه. أنا حاسبها بالقلم... خمسين في المية."
},
{
"start": 32.88999999999999,
"key": "J06",
"dur": 3.68,
"text": "الليلة هنطلع لحد الباب. ثقوا فيا المرة دي!"
},
{
"start": 39.72,
"key": "J07",
"dur": 1.44,
"text": "النور قطع!"
},
{
"start": 41.26,
"key": "J08",
"dur": 1.68,
"text": "ولعوا الكشاف بسرعة!"
},
{
"start": 46.589999999999996,
"key": "J09",
"dur": 2.8,
"text": "شفتوا الضل اللي عدى على الحيطة؟"
},
{
"start": 49.489999999999995,
"key": "J10",
"dur": 2.56,
"text": "كان طويل... طويل أوي!"
},
{
"start": 52.199999999999996,
"key": "J11",
"dur": 6.64,
"text": "لأ، استنوا... الكشاف كان تحت. والنور لما بييجي من تحت، بيخلي الضل أطول من صاحبه."
},
{
"start": 59.04,
"key": "J12",
"dur": 5.52,
"text": "لغز النهارده: صاحب الضل ده كان طويل، ولا قصير؟ اكتبوا في الكومنتات!"
},
{
"start": 66.71,
"key": "J13",
"dur": 2.96,
"text": "الكشاف فصل... أنا كنت حاسبها."
},
{
"start": 70.16999999999999,
"key": "J14",
"dur": 4.28,
"text": "شطة... يا شطة..."
},
{
"start": 73.89999999999999,
"key": "J15",
"dur": 3.6,
"text": "إنتو سامعين؟... حد بينادي عليا باسمي!"
},
{
"start": 77.79999999999998,
"key": "J16",
"dur": 4.12,
"text": "شطة... تعالى."
}
]
}