"lines": [
{
"start": 4.75,
"key": "P01",
"dur": 4.8,
"text": "لغز امبارح: اللي قالوا أستاذ فهمي... صح! القلم الأحمر كان في جيبه."
},
{
"start": 9.67,
"key": "P02",
"dur": 3.76,
"text": "خلاص. الليلة هندخل الدور السابع، مهما حصل!"
},
{
"start": 13.53,
"key": "P03",
"dur": 3.36,
"text": "من غير الكشكول؟ ...أنا مش عارف أحسبها."
},
{
"start": 20.040000000000003,
"key": "P04",
"dur": 3.04,
"text": "بصوا... البواب داخل جوه بمفتاحه!"
},
{
"start": 24.640000000000004,
"key": "P05",
"dur": 2.72,
"text": "مشي... بس الباب لسه مفتوح!"
},
{
"start": 27.460000000000004,
"key": "P06",
"dur": 3.6,
"text": "يلا... قبل ما حد يشوفنا. ثقوا فيا!"
},
{
"start": 33.410000000000004,
"key": "P07",
"dur": 3.36,
"text": "تلاتين سنة... وكل حاجة زي ما هي."
},
{
"start": 42.32,
"key": "P08",
"dur": 1.92,
"text": "الراديو اشتغل لوحده!"
},
{
"start": 44.49,
"key": "P09",
"dur": 2.24,
"text": "استنوا... بصوا على الحيطة."
},
{
"start": 46.830000000000005,
"key": "P10",
"dur": 1.68,
"text": "فيه حاجة ناقصة هنا..."
},
{
"start": 48.910000000000004,
"key": "P11",
"dur": 4.16,
"text": "لغز النهارده: إيه الحاجة الناقصة في الأوضة؟ اكتبوا في الكومنتات!"
},
{
"start": 53.67000000000001,
"key": "P12",
"dur": 3.76,
"text": "والبكرة اللي بره الشباك دي... ليه مربوط فيها حاجة؟"
},
{
"start": 61.93000000000001,
"key": "P13",
"dur": 2.8,
"text": "الباب! حد قفل علينا من بره!"
},
{
"start": 64.83,
"key": "P14",
"dur": 3.04,
"text": "إحنا محبوسين... في الدور السابع."
}
]
}