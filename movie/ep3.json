"lines": [
{
"start": 1.45,
"key": "H00",
"dur": 1.92,
"text": "مين اللي طالع على السلم ده؟!"
},
{
"start": 9.049999999999999,
"key": "H01",
"dur": 4.72,
"text": "اللي قالوا الدور السابع، من تلاتين سنة... برافو عليكو! إجابتكو صح!"
},
{
"start": 13.97,
"key": "H02",
"dur": 4.0,
"text": "المفتاح اتسرق! كان تحت المخدة، والشباك كان مفتوح!"
},
{
"start": 18.119999999999997,
"key": "H03",
"dur": 5.52,
"text": "الأوضة في الدور التاني. يعني الحرامي يا إما بيطير... يا إما من جوه العمارة."
},
{
"start": 23.839999999999996,
"key": "H04",
"dur": 3.6,
"text": "وأنا شفت ده على الشباك... خيط أبيض، من جلابية!"
},
{
"start": 27.639999999999997,
"key": "H05",
"dur": 4.48,
"text": "جلابية؟! مفيش حد بيلبس جلابية في العمارة غير..."
},
{
"start": 32.269999999999996,
"key": "H06",
"dur": 1.12,
"text": "البواب."
},
{
"start": 34.589999999999996,
"key": "H07",
"dur": 3.52,
"text": "خلاص. الليلة هنستناه، ونشوف بيعمل إيه."
},
{
"start": 44.66,
"key": "H08",
"dur": 4.4,
"text": "شطة! بطل تاكل شيبسي! صوته مسموع لحد السطوح!"
},
{
"start": 49.809999999999995,
"key": "H09",
"dur": 2.24,
"text": "أنا باكل بالراحة والله..."
},
{
"start": 52.3,
"key": "H10",
"dur": 3.52,
"text": "بصوا... الدكة فاضية! البواب مش نايم!"
},
{
"start": 58.77,
"key": "H11",
"dur": 2.8,
"text": "ماسك المفتاح... وطالع لفوق."
},
{
"start": 69.47,
"key": "H12",
"dur": 4.4,
"text": "تلاتة سريعين... تلاتة طوال... وتلاتة سريعين تاني!"
},
{
"start": 74.07000000000001,
"key": "H13",
"dur": 4.32,
"text": "لغز النهارده: الخبط ده معناه إيه؟ اكتبوا في الكومنتات!"
},
{
"start": 80.49000000000001,
"key": "H14",
"dur": 1.84,
"text": "هاتشو!"
},
{
"start": 86.43,
"key": "H15",
"dur": 1.6,
"text": "أنا شايفكم."
}
]
}