"lines": [
{
"start": 4.08,
"key": "L01",
"dur": 3.12,
"text": "استنوا! الخبط ده... مش زي بعضه!"
},
{
"start": 9.0,
"key": "L02",
"dur": 7.2,
"text": "لغز امبارح: اللي قالوا السماعات... صح. ست سماعات، وكلهم فيهم نفس اللمبة الحمرا."
},
{
"start": 16.3,
"key": "L03",
"dur": 4.8,
"text": "الخبط التقيل جاي من السماعة... لكن الخبط الخفيف ده، إيد بني آدم!"
},
{
"start": 21.6,
"key": "L04",
"dur": 2.32,
"text": "الكشكول! الورقة طارت!"
},
{
"start": 23.970000000000002,
"key": "L05",
"dur": 2.16,
"text": "أنا هجيبها! ثقوا فيا!"
},
{
"start": 26.230000000000004,
"key": "L06",
"dur": 2.88,
"text": "شطة! حاسب السور!"
},
{
"start": 30.410000000000004,
"key": "L07",
"dur": 4.32,
"text": "جبتها... بس أنا مش هبص لتحت تاني أبدا."
},
{
"start": 35.830000000000005,
"key": "L08",
"dur": 2.96,
"text": "حد طالع! استخبوا ورا خزان المية!"
},
{
"start": 41.040000000000006,
"key": "L09",
"dur": 6.16,
"text": "أيوه يا باشا... الخطة ماشية. أسبوع واحد بس، والسكان كلهم هيبيعوا."
},
{
"start": 51.26000000000001,
"key": "L10",
"dur": 3.2,
"text": "تاني الخبط ده؟! ...مين بيلعب من ورايا؟"
},
{
"start": 56.16000000000002,
"key": "L11",
"dur": 4.24,
"text": "زلطة، اكتب بسرعة! خط ونقطة... نقطة وخط..."
},
{
"start": 60.55000000000002,
"key": "L12",
"dur": 6.96,
"text": "لغز النهارده: فكوا الشفرة معايا! الحرف الأول N، والتاني A... كملوا الكلمة في الكومنتات!"
},
{
"start": 68.11000000000001,
"key": "L13",
"dur": 4.88,
"text": "N... A... N... A. نانا؟"
},
{
"start": 73.14000000000001,
"key": "L14",
"dur": 4.08,
"text": "نانا... يعني نعناعة! الرسالة لتيتا!"
},
{
"start": 77.57000000000001,
"key": "L15",
"dur": 2.32,
"text": "بتعملوا إيه فوق السطوح في نص الليل؟!"
},
{
"start": 81.99,
"key": "L16",
"dur": 1.44,
"text": "رشدي؟..."
}
]
}