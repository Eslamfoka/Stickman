"lines": [
{
"start": 3.1,
"key": "R01",
"dur": 2.08,
"text": "الليلة... هنمسكه."
},
{
"start": 7.279999999999999,
"key": "R02",
"dur": 5.68,
"text": "لغز امبارح: مين اللي قفل علينا الباب؟... أستاذ فهمي! البونبوني بتاعه هو اللي فضحه!"
},
{
"start": 13.059999999999999,
"key": "R03",
"dur": 7.12,
"text": "الخطة: شطة في البدروم عند مفتاح النور. أنا وتوتة فوق عند فتحة التهوية. والبواب على السلم."
},
{
"start": 20.33,
"key": "R04",
"dur": 3.36,
"text": "البدروم؟! لوحدي؟... في العتمة؟"
},
{
"start": 23.79,
"key": "R05",
"dur": 3.44,
"text": "إيه يا شطة... خايف من العتمة؟"
},
{
"start": 27.28,
"key": "R06",
"dur": 2.88,
"text": "أنا؟! أبداً... ثقوا فيا!"
},
{
"start": 31.16,
"key": "R07",
"dur": 4.48,
"text": "وأنا معاكو! طنط سوسن هتصور كل حاجة... لايف!"
},
{
"start": 35.74,
"key": "R08",
"dur": 6.08,
"text": "رشدي أخويا... ساب سر في العمارة دي؟... يبقى أنا جاية معاكو. والشبشب جاي معايا!"
},
{
"start": 42.519999999999996,
"key": "R09",
"dur": 2.24,
"text": "خلاص... كله في مكانه."
},
{
"start": 50.559999999999995,
"key": "R10",
"dur": 2.64,
"text": "النور راح... وأنا لوحدي."
},
{
"start": 56.0,
"key": "R11",
"dur": 2.0,
"text": "ده... أستاذ فهمي!"
},
{
"start": 58.1,
"key": "R12",
"dur": 4.16,
"text": "نخوفهم شوية كمان... وبكرة يمضوا على البيع."
},
{
"start": 62.71000000000001,
"key": "R13",
"dur": 1.92,
"text": "مش الليلة يا أستاذ فهمي!"
},
{
"start": 65.28000000000002,
"key": "R14",
"dur": 1.04,
"text": "إنت؟!"
},
{
"start": 68.02000000000002,
"key": "R15",
"dur": 5.2,
"text": "بص يا زلطة! سلك نازل من فتحة التهوية... لحد شباك الدور الخامس!"
},
{
"start": 73.32000000000002,
"key": "R16",
"dur": 4.0,
"text": "سماعة. يعني العفريت... بيشتغل بالكهربا."
},
{
"start": 78.52000000000002,
"key": "R17",
"dur": 6.96,
"text": "أهلاً يا متابعين! إحنا لايف... وده يا جماعة أستاذ فهمي، اللي بيخوف العمارة كلها!"
},
{
"start": 85.58000000000001,
"key": "R18",
"dur": 7.6,
"text": "ما تشغلوش بالكم يا حلوين... العمارة هتتباع بكرة، والسر اللي بتدوروا عليه ضاع من تلاتين سنة!"
},
{
"start": 93.28,
"key": "R19",
"dur": 3.6,
"text": "لا... ما ضاعش. أنا عارفة هو فين."
},
{
"start": 100.38,
"key": "R20",
"dur": 2.8,
"text": "البكرة! عم رشدي خباه في البكرة!"
},
{
"start": 103.58,
"key": "R21",
"dur": 5.76,
"text": "ده خط رشدي... العمارة دي بتاعة السكان كلهم... ومش هتتباع!"
},
{
"start": 109.54,
"key": "R22",
"dur": 4.56,
"text": "رشدي... يا حبيبي. لسه بيحافظ علينا من بعيد."
},
{
"start": 114.5,
"key": "R23",
"dur": 2.88,
"text": "رايح فين يا فهمي؟!... الشبشب جايلك!"
},
{
"start": 119.92999999999999,
"key": "R24",
"dur": 1.76,
"text": "أنا صاحي أهو."
},
{
"start": 122.89,
"key": "R25",
"dur": 3.04,
"text": "مليون مشاهدة يا جماعة!"
},
{
"start": 126.03,
"key": "R26",
"dur": 2.56,
"text": "شفتوا؟ قلتلكو ثقوا فيا!"
},
{
"start": 128.69,
"key": "R27",
"dur": 2.32,
"text": "أنا كنت حاسبها بالقلم من الأول."
},
{
"start": 131.20999999999998,
"key": "R28",
"dur": 5.68,
"text": "لغز النهارده: إنتو خمنتوا من الأول إن فهمي هو اللي ورا الخبط؟ اكتبوا في الكومنتات!"
},
{
"start": 139.68999999999997,
"key": "R29",
"dur": 2.48,
"text": "جواب... من برا مصر!"
},
{
"start": 142.36999999999995,
"key": "R30",
"dur": 2.96,
"text": "ده خط رشدي!... افتحوا البدروم."
},
{
"start": 147.67999999999998,
"key": "R31",
"dur": 2.32,
"text": "البدروم؟!... تاني؟!"
}
]
}