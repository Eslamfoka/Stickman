"lines": [
{
"start": 0.7000000000000001,
"key": "K01",
"dur": 1.36,
"text": "عفريت!"
},
{
"start": 2.46,
"key": "K02",
"dur": 1.7182766439909296,
"text": "دي قطة يا شطة."
},
{
"start": 4.278276643990929,
"key": "K03",
"dur": 3.2,
"text": "طب لو دي... مين اللي كان بينادي عليا؟!"
},
{
"start": 7.578276643990929,
"key": "K04",
"dur": 3.76,
"text": "بصوا فوق... فيه نور أحمر صغير في فتحة التهوية!"
},
{
"start": 13.338276643990929,
"key": "K05",
"dur": 5.68,
"text": "لغز امبارح: اللي قالوا قصير... إجابتكو صح! الضل كان طويل، بس صاحبه قصير."
},
{
"start": 21.368276643990928,
"key": "K06",
"dur": 5.68,
"text": "صباح الفل يا حلوين! أنا أستاذ فهمي، جاركم الجديد في الدور الخامس!"
},
{
"start": 28.44827664399093,
"key": "K07",
"dur": 2.8,
"text": "الحلويات دي تحفة يا أستاذ فهمي!"
},
{
"start": 31.348276643990932,
"key": "K08",
"dur": 4.4,
"text": "محدش بيسكن في العمارة دي... إلا لو وراه حاجة."
},
{
"start": 35.89827664399093,
"key": "K09",
"dur": 6.0,
"text": "ما تشغلوش بالكم يا حلوين! اطلعوا عندي، عندي حاجات حلوة كتير."
},
{
"start": 43.44827664399093,
"key": "K10",
"dur": 4.4,
"text": "ست سماعات في أوضة واحدة... أنا حاسبها: ده مش طبيعي."
},
{
"start": 47.99827664399093,
"key": "K11",
"dur": 4.16,
"text": "واللمبة الحمرا اللي في السماعة... نفس اللي شفناها في فتحة التهوية!"
},
{
"start": 52.30827664399093,
"key": "K12",
"dur": 4.56,
"text": "لغز النهارده: إيه الغريب في بيت أستاذ فهمي؟ اكتبوا في الكومنتات!"
},
{
"start": 58.96827664399093,
"key": "K13",
"dur": 2.8,
"text": "أنا آسف! الكرتونة وقعت لوحدها!"
},
{
"start": 61.81827664399093,
"key": "K14",
"dur": 3.36,
"text": "سيبها! ...ما تشغلوش بالكم يا حلوين."
},
{
"start": 65.32827664399093,
"key": "K15",
"dur": 4.48,
"text": "شفتوا المفتاح اللي وقع؟ مكتوب عليه سبعة... تلاتين."
},
{
"start": 70.00827664399094,
"key": "K16",
"dur": 4.0,
"text": "بس المفتاح ده مع البواب! يبقى إزاي معاه هو كمان؟!"
},
{
"start": 76.25827664399094,
"key": "K17",
"dur": 3.44,
"text": "أنا عندي مفاتيح... لكل الأبواب."
}
]
}